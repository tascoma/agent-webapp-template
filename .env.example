# ─── App ─────────────────────────────────────────────────────────────────────
# development | staging | production
APP_ENV=development

# Generate with: openssl rand -hex 32
SECRET_KEY=changeme

HOST=127.0.0.1
PORT=8000

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Development default is the Vite dev server.
# Production: set to your Render frontend URL.
ALLOWED_ORIGINS=http://localhost:5173

# ─── Supabase Storage (optional) ─────────────────────────────────────────────
# Only needed if you use Supabase Storage (see /setup-storage). Leave blank
# otherwise — the base app boots without these. Values from the Supabase
# dashboard → Settings → API.
SUPABASE_URL=
# Service role key — used server-side for storage uploads (bypasses RLS).
SUPABASE_SERVICE_ROLE_KEY=
# Storage bucket name (created in Supabase dashboard → Storage).
STORAGE_BUCKET=uploads

# ─── Database ────────────────────────────────────────────────────────────────
# Database connection URL (SQLAlchemy async driver).
# Development: SQLite (no Supabase needed).
DATABASE_URL=sqlite+aiosqlite:///./app.db
# Staging / production: Supabase transaction pooler (port 6543).
# DATABASE_URL=postgresql+asyncpg://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# ─── AI ──────────────────────────────────────────────────────────────────────
# Obtain from https://console.anthropic.com
ANTHROPIC_API_KEY=your-api-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

# ─── Logging ─────────────────────────────────────────────────────────────────
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
